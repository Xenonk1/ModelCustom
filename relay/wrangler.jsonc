{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modelcustom-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
